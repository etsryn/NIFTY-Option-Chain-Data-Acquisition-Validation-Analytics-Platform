{
    "manifest_version": 3,

    "name": "NSE Option Chain → Excel",

    "version": "1.3.0",

    "description": "Live NIFTY option chain to Excel.",

    "key": "",

    "permissions": [
        "activeTab",
        "scripting",
        "notifications",
        "storage",
        "tabs"
    ],

    "host_permissions": [
        "https://www.nseindia.com/*",
        "http://127.0.0.1:5000/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://www.nseindia.com/*"
            ],

            "js": [
                "schema_validator.js",
                "content.js"
            ],

            "run_at": "document_idle"
        }
    ],

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_popup": "popup.html"
    }
}